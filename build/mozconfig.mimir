# Build Mimir (Linux / WSL2). Lance par scripts/build-wsl.sh.
# L'objdir garde le nom obj-validate pour reutiliser la compilation du build non modifie
# (seul ce qui depend du branding est recompile).
ac_add_options --enable-application=browser
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-validate

# Identite : profil separe de Firefox (~/.config/mimir/mimir, %APPDATA%\Mimir\Mimir).
# Le vendor est fixe par patches/0002-vendor-mimir.patch.
ac_add_options --with-branding=browser/branding/mimir
ac_add_options --with-app-basename=Mimir

ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
